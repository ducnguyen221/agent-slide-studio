{
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "max_image_requests": {
          "default": 0,
          "minimum": 0,
          "title": "Max Image Requests",
          "type": "integer"
        },
        "max_provider_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Provider Cost"
        },
        "max_repair_rounds": {
          "default": 0,
          "minimum": 0,
          "title": "Max Repair Rounds",
          "type": "integer"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "max_yaml_bytes": {
          "default": 5242880,
          "exclusiveMinimum": 0,
          "title": "Max Yaml Bytes",
          "type": "integer"
        },
        "max_yaml_depth": {
          "default": 64,
          "exclusiveMinimum": 0,
          "title": "Max Yaml Depth",
          "type": "integer"
        },
        "max_yaml_nodes": {
          "default": 100000,
          "exclusiveMinimum": 0,
          "title": "Max Yaml Nodes",
          "type": "integer"
        },
        "render_timeout_seconds": {
          "default": 120,
          "exclusiveMinimum": 0,
          "title": "Render Timeout Seconds",
          "type": "number"
        }
      },
      "title": "Limits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval_policy": {
      "default": "interactive",
      "enum": [
        "interactive",
        "ask",
        "auto-safe",
        "full"
      ],
      "title": "Approval Policy",
      "type": "string"
    },
    "authoring_mode": {
      "default": "semantic",
      "enum": [
        "semantic",
        "html"
      ],
      "title": "Authoring Mode",
      "type": "string"
    },
    "backend": {
      "default": "pptx-native",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Backend",
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "deck_path": {
      "default": "storyboard/deck.yaml",
      "title": "Deck Path",
      "type": "string"
    },
    "language": {
      "default": "vi",
      "title": "Language",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/Limits"
    },
    "network_policy": {
      "default": "local-only",
      "enum": [
        "offline",
        "local-only",
        "allowlist",
        "open"
      ],
      "title": "Network Policy",
      "type": "string"
    },
    "profile_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile Ref"
    },
    "project_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "purpose": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Purpose"
    },
    "requested_outputs": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Requested Outputs",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "title"
  ],
  "title": "ProjectConfig",
  "type": "object"
}
