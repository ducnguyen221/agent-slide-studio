{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "ref"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ObservedValue": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "origin": {
          "enum": [
            "measured",
            "inferred",
            "user-specified"
          ],
          "title": "Origin",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "origin"
      ],
      "title": "ObservedValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "applied_overrides": {
      "additionalProperties": {
        "$ref": "#/$defs/ObservedValue"
      },
      "title": "Applied Overrides",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "font_resolution": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Font Resolution",
      "type": "object"
    },
    "resolved_ref": {
      "title": "Resolved Ref",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "source_scope": {
      "enum": [
        "builtin",
        "user",
        "project"
      ],
      "title": "Source Scope",
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "resolved_ref",
    "source_scope",
    "version",
    "sha256",
    "created_at"
  ],
  "title": "ProfileLock",
  "type": "object"
}
