{
  "$defs": {
    "Canvas": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "ratio": {
          "default": "16:9",
          "enum": [
            "16:9",
            "4:3",
            "custom"
          ],
          "title": "Ratio",
          "type": "string"
        },
        "unit": {
          "default": "inch",
          "enum": [
            "inch",
            "px"
          ],
          "title": "Unit",
          "type": "string"
        },
        "width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        }
      },
      "title": "Canvas",
      "type": "object"
    },
    "CapacityHint": {
      "additionalProperties": false,
      "properties": {
        "max_characters": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Characters"
        },
        "max_lines": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Lines"
        },
        "min_characters": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Characters"
        }
      },
      "title": "CapacityHint",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "ref"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "LockedElement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "reason"
      ],
      "title": "LockedElement",
      "type": "object"
    },
    "RepeatGroup": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "max_items": {
          "minimum": 1,
          "title": "Max Items",
          "type": "integer"
        },
        "members": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Members",
          "type": "array"
        },
        "min_items": {
          "default": 0,
          "minimum": 0,
          "title": "Min Items",
          "type": "integer"
        },
        "reflow_policy": {
          "enum": [
            "fixed",
            "compact",
            "wrap",
            "switch-layout"
          ],
          "title": "Reflow Policy",
          "type": "string"
        }
      },
      "required": [
        "id",
        "members",
        "max_items",
        "reflow_policy"
      ],
      "title": "RepeatGroup",
      "type": "object"
    },
    "TemplateCertification": {
      "additionalProperties": false,
      "properties": {
        "render_evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Render Evidence",
          "type": "array"
        },
        "rights_verified": {
          "default": false,
          "title": "Rights Verified",
          "type": "boolean"
        },
        "status": {
          "default": "candidate",
          "enum": [
            "candidate",
            "certified",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "title": "TemplateCertification",
      "type": "object"
    },
    "TemplateConstraints": {
      "additionalProperties": false,
      "properties": {
        "max_slides": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Slides"
        },
        "min_font_size": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Font Size"
        }
      },
      "title": "TemplateConstraints",
      "type": "object"
    },
    "TemplateSlot": {
      "additionalProperties": false,
      "properties": {
        "capacity_hint": {
          "anyOf": [
            {
              "$ref": "#/$defs/CapacityHint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Kind",
          "type": "string"
        },
        "max_items": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Items"
        },
        "min_items": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Items"
        },
        "placement_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Placement Ref"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "TemplateSlot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "backends": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Backends",
      "type": "array"
    },
    "canvas": {
      "$ref": "#/$defs/Canvas"
    },
    "certification": {
      "$ref": "#/$defs/TemplateCertification"
    },
    "constraints": {
      "$ref": "#/$defs/TemplateConstraints"
    },
    "files": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "locked_elements": {
      "items": {
        "$ref": "#/$defs/LockedElement"
      },
      "title": "Locked Elements",
      "type": "array"
    },
    "preview": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preview"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Provenance",
      "type": "array"
    },
    "repeat_groups": {
      "items": {
        "$ref": "#/$defs/RepeatGroup"
      },
      "title": "Repeat Groups",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "slots": {
      "items": {
        "$ref": "#/$defs/TemplateSlot"
      },
      "title": "Slots",
      "type": "array"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "backends",
    "canvas",
    "files",
    "slots"
  ],
  "title": "TemplatePack",
  "type": "object"
}
